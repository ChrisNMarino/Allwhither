{
    "ui": {
        "controls": {
            "file-panel": {
                "type": "panel",
                "label": "Open a vault",
                "children": [
                    "intro",
                    "chosen-file",
                    "master-password",
                    "choose-file",
                    "open-vault",
                    "create-vault"
                ]
            },
            "intro": {
                "type": "label",
                "text": "Key Viper keeps passwords in an encrypted file you choose. The file opens only with the correct password."
            },
            "chosen-file": {
                "type": "label",
                "text": "No file selected"
            },
            "master-password": {
                "type": "textField",
                "label": "Password",
                "value": "",
                "placeholder": "Vault password",
                "password": true
            },
            "choose-file": {
                "type": "button",
                "text": "Choose file",
                "clickedText": "Choose file",
                "actions": {
                    "click": { "file": "file-panel.js", "function": "chooseVault" }
                }
            },
            "open-vault": {
                "type": "button",
                "text": "Open",
                "clickedText": "Open",
                "actions": {
                    "click": { "file": "file-panel.js", "function": "openVault" }
                }
            },
            "create-vault": {
                "type": "button",
                "text": "Create new file",
                "clickedText": "Create new file",
                "actions": {
                    "click": { "file": "file-panel.js", "function": "createVault" }
                }
            }
        }
    }
}